DATABASE_URL="postgresql://postgres:[senha]@[host]:[porta]/railway"
JWT_SECRET="gerar com: openssl rand -base64 64"
JWT_EXPIRES_IN="10h"
PORT=3000
NODE_ENV=production
TZ="America/Sao_Paulo"
META_APP_SECRET="do painel do App no Meta for Developers, aba Configurações Básicas"
META_VERIFY_TOKEN="qualquer string sua — é o que você digita no painel do Meta ao configurar o webhook"
OPENAI_API_KEY="sk-... da plataforma da OpenAI"
OPENAI_MODEL="gpt-5.1-mini"
META_ACCESS_TOKEN="token de acesso permanente do painel do App no Meta for Developers -- Fase 15 (Embedded Signup) move a fonte disso pra WhatsappBusinessAccount, ver CONTEXTO.md; esta var vira legado assim que a Fase 15 estiver ligada de ponta a ponta"
META_PHONE_NUMBER_ID="ID do número de telefone do WhatsApp Business, painel do Meta -- mesma nota acima"
META_APP_ID="do painel do App no Meta for Developers, aba Configurações Básicas (mesmo lugar do META_APP_SECRET)"
WHATSAPP_TOKEN_ENCRYPTION_KEY="gerar com: openssl rand -base64 32 -- cifra o accessToken da WABA em repouso no banco"

# Fase 17 -- base da Graph API. NAO setar em producao: o padrao ja e
# https://graph.facebook.com/v21.0. Existe so pra apontar o envio pra um stub
# local durante teste de ponta a ponta.
